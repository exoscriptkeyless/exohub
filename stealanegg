    fpsOptEnabled = not fpsOptEnabled
    if fpsOptEnabled then
        fpsButton.Text = "ON"
        fpsButton.TextColor3 = Color3.fromRGB(255, 255, 255)
        
        originalPartProps = {}
        for _, v in ipairs(Workspace:GetDescendants()) do
            if v:IsA("BasePart") then
                originalPartProps[v] = {
                    Material = v.Material,
                    Reflectance = v.Reflectance
                }
                v.Material = Enum.Material.SmoothPlastic
                v.Reflectance = 0
            elseif v:IsA("Decal") or v:IsA("Texture") then
                originalPartProps[v] = {Transparency = v.Transparency}
                v.Transparency = 1
            elseif v:IsA("ParticleEmitter") or v:IsA("Fire") or v:IsA("Smoke") or v:IsA("Sparkles") then
                originalPartProps[v] = {Enabled = v.Enabled}
                v.Enabled = false
            end
        end
        Lighting.GlobalShadows = false
        Lighting.FogEnd = 9e9
    else
        fpsButton.Text = "OFF"
        fpsButton.TextColor3 = Color3.fromRGB(150, 150, 150)
        
        for obj, props in pairs(originalPartProps) do
            if obj and obj.Parent then
                for prop, val in pairs(props) do
                    obj[prop] = val
                end
            end
        end
        Lighting.GlobalShadows = true
        Lighting.FogEnd = 100000
    end
end)

