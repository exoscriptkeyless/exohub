-- Tab Switching Logic
local function selectTab(activeBtn, activePage)
    for _, p in ipairs({pageOwner, pageKeyless, pageNonKeyless, pageServerHop, pageSettings}) do
        p.Visible = false
    end
    for _, b in ipairs({btnOwner, btnKeyless, btnNonKeyless, btnServerHop, btnSettings}) do
        b.TextColor3 = Color3.fromRGB(130, 130, 130)
        b.Font = Enum.Font.GothamBold
    end
    
    activePage.Visible = true
    activeBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
end

