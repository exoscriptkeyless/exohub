-- Action Card Creator
local function createActionCard(parent, title, yPos, callback)
    local card = Instance.new("TextButton")
    card.Size = UDim2.new(1, 0, 0, 44)
    card.Position = UDim2.new(0, 0, 0, yPos)
    card.BackgroundColor3 = Color3.fromRGB(8, 8, 8)
    card.BorderSizePixel = 0
    card.AutoButtonColor = false
    card.Text = ""
    card.Parent = parent

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = card

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(50, 50, 50)
    stroke.Thickness = 1
    stroke.Parent = card

    local titleLabel = Instance.new("TextLabel")
    titleLabel.Size = UDim2.new(1, -35, 1, 0)
    titleLabel.Position = UDim2.new(0, 12, 0, 0)
    titleLabel.BackgroundTransparency = 1
    titleLabel.Font = Enum.Font.GothamMedium
    titleLabel.Text = title
    titleLabel.TextColor3 = Color3.fromRGB(240, 240, 240)
    titleLabel.TextSize = 11
    titleLabel.TextXAlignment = Enum.TextXAlignment.Left
    titleLabel.Parent = card

    local actionLabel = Instance.new("TextLabel")
    actionLabel.Size = UDim2.new(0, 60, 1, 0)
    actionLabel.Position = UDim2.new(1, -70, 0, 0)
    actionLabel.BackgroundTransparency = 1
    actionLabel.Font = Enum.Font.GothamBold
    actionLabel.Text = "RUN ➔"
    actionLabel.TextColor3 = Color3.fromRGB(160, 160, 160)
    actionLabel.TextSize = 10
    actionLabel.TextXAlignment = Enum.TextXAlignment.Right
    actionLabel.Parent = card

    card.MouseEnter:Connect(function()
        card.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
        stroke.Color = Color3.fromRGB(255, 255, 255)
        actionLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    end)

    card.MouseLeave:Connect(function()
        card.BackgroundColor3 = Color3.fromRGB(8, 8, 8)
        stroke.Color = Color3.fromRGB(50, 50, 50)
        actionLabel.TextColor3 = Color3.fromRGB(160, 160, 160)
    end)

    if callback then
        card.MouseButton1Click:Connect(callback)
    end

    return card
end

